  "correlation_obligations": {
    "INFRA-002": [
      "ECS task definitions consume the exact immutable ECR digests reported by the build."
    ],
    "INFRA-005": [
      "The regional WAF web ACL is associated with the internal ALB and its rate rule uses ForwardedIPConfig with fallback MATCH and position LAST."
    ],
    "INFRA-006": [
      "Only the CloudFront origin-facing managed prefix list reaches the internal ALB, only the ALB reaches tasks, and task ENIs have no public IP.",
      "Private tasks resolve VPC DNS and reach required AWS APIs over outbound TLS through the single ephemeral NAT gateway.",
      "IAM resources and actions resolve to the intended table, repositories, logs, metrics, and secret rather than merely existing."
    ],
    "INFRA-007": [
      "Each raw and SDK task definition references the Secrets Manager state-key ARN through its secrets binding."
    ],
    "INFRA-008": [
      "The synthesized Nginx, ALB, and WAF logging paths actually use the redacting/omitting configurations."
    ],
    "CICD-005": [
      "Acceptance consumes the digest produced by the single image-build job, not a rebuilt tag."
    ],
    "CICD-006": [
      "Every AWS-touching job has its own OIDC credential step and id-token: write permission."
    ],
    "CICD-008": [
      "Destroy and inventory reporting run under an unconditional failure path after any approved cloud apply."
    ],
    "INFRA-004": [
      "The generated CloudFront hostname and default certificate are the only public application endpoint and the distribution reaches the internal ALB through its VPC origin.",
      "ALB rules preserve /raw/mcp and /sdk/mcp for their respective target groups while every unmatched path returns a fixed 404 without forwarding.",
      "Deployed SSE is neither compressed, buffered, nor cached and heartbeat cadence stays below both pinned 60-second hop timeouts."
    ],
    "INFRA-010": [
      "Execute the lifecycle artifact against AWS and require post-destroy inventory to show no stack resources, distribution, VPC-origin ENI, image repository, or pending secret.",
      "The normal order is edge then zero-task workload then immutable image push then two-task workload; teardown reverses it. If the reviewed size fallback is activated, use network then distribution then workload and reverse that order."
    ]
  }

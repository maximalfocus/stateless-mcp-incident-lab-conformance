  "correlation_obligations": {
    "INFRA-002": [
      "ECS task definitions consume the exact immutable ECR digests reported by the build."
    ],
    "INFRA-005": [
      "The WAF web ACL is associated with the internet-facing ALB."
    ],
    "INFRA-006": [
      "Ingress sources, IAM resources, and actions resolve to the intended service/table/log/secret resources rather than merely existing."
    ],
    "INFRA-007": [
      "Each raw and SDK task definition references the Secrets Manager state-key ARN through its secrets binding."
    ],
    "INFRA-008": [
      "The synthesized Nginx, ALB, and WAF logging paths actually use the redacting/omitting configurations."
    ],
    "CICD-005": [
      "Acceptance consumes the digest produced by the single image-build job, not a rebuilt tag."
    ],
    "CICD-006": [
      "Every AWS-touching job has its own OIDC credential step and id-token: write permission."
    ],
    "CICD-008": [
      "Destroy and inventory reporting run under an unconditional failure path after any approved cloud apply."
    ]
  }
